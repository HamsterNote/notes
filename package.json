{
  "name": "@hamster-note/notes",
  "version": "2.0.0",
  "description": "React components for note content rendering and presentation.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/index.js.map",
    "dist/formula.css",
    "dist/fonts",
    "dist/lib",
    "dist/styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./formula.css": "./dist/formula.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "vite": "^7.0.4"
  },
  "engines": {
    "node": ">=20.19.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts --host 0.0.0.0 --port 9235",
    "build": "yarn build:lib && yarn build:demo",
    "build:lib": "vite build --config vite.config.ts && node ./scripts/sync-library-css.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts --host 0.0.0.0 --port 9235",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "release:prepare": "node ./scripts/prepare-release.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@system-ui-js/multi-drag": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@hamster-note/cards": "0.3.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/unist": "^3.0.3",
    "@system-ui-js/multi-drag": "^0.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "6.0.0-beta",
    "typescript-eslint": "^8.37.0",
    "unified": "^11.0.5",
    "vite": "^7.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.10"
  },
  "dependencies": {
    "@hamster-note/components": "^0.2.1-beta.2",
    "@hamster-note/painting": "0.2.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "use-undo": "^1.2.0"
  }
}
